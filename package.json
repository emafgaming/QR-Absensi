{
  "name": "wisudaattend-monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "build:server": "npm --prefix server run build",
    "build:client": "npm --prefix client run build",
    "build": "npm --prefix server run prisma:generate && npm run build:server && npm run build:client",
    "vercel-build": "npm run build",
    "test:server": "npm --prefix server run test",
    "prisma:generate": "npm --prefix server run prisma:generate",
    "prisma:push": "npm --prefix server run prisma:push",
    "prisma:seed": "npm --prefix server run prisma:seed"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "prisma": "^5.22.0",
    "qrcode": "^1.5.4",
    "zod": "^3.23.8"
  }
}
